# Public Supabase project settings (URL and publishable/anon key only).
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_KEY=
NUXT_PUBLIC_VPN_AUTH_URL=http://127.0.0.1:3003
NUXT_PUBLIC_VPN_SITE_URL=http://127.0.0.1:3003
NUXT_PUBLIC_VPN_NEWS_URL=http://127.0.0.1:3000
NUXT_PUBLIC_VPN_MONITOR_URL=http://127.0.0.1:3001

# Local development: Site 3003, Monitor 3001, News 3000.
NUXT_AUTH_RETURN_ORIGINS=http://127.0.0.1:3003,http://127.0.0.1:3001,http://127.0.0.1:3000

# Production:
# NUXT_PUBLIC_VPN_AUTH_URL=https://vpn.labafero.com
# Preview: configure all three NUXT_PUBLIC_VPN_*_URL values to the matching branch deployments.
# Production defaults are vpn.labafero.com, vpn-news.labafero.com, vpn-monitor.labafero.com.
# NUXT_AUTH_RETURN_ORIGINS=https://vpn.labafero.com,https://vpn-monitor.labafero.com,https://vpn-news.labafero.com
