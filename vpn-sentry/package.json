{
  "name": "@vpn/sentry",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "nuxt dev --port 3002 --dotenv .env",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "workers": "node workers/index.mjs",
    "workers:twitch": "tsx --env-file=.env workers/validate-twitch.mjs",
    "workers:reconcile": "tsx --env-file=.env workers/reconcile-twitch.mjs"
  },
  "dependencies": {
    "@nuxt/eslint": "^1.15.2",
    "@nuxtjs/supabase": "2.0.9",
    "@vpn/contracts": "workspace:*",
    "@vpn/database": "workspace:*",
    "h3": "1.15.4",
    "nuxt": "^4.4.6",
    "postgres": "3.4.9",
    "tsx": "4.23.15",
    "valibot": "^1.4.1"
  },
  "devDependencies": {
    "eslint": "^10.4.0",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.0"
  }
}
