{
  "name": "vpn-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "scripts": {
    "dev:news": "pnpm --filter @vpn/news dev",
    "dev:monitor": "pnpm --filter @vpn/monitor dev",
    "dev:sentry": "pnpm --filter @vpn/sentry dev",
    "lint": "pnpm --recursive --if-present lint",
    "typecheck": "pnpm --recursive --if-present typecheck",
    "build": "pnpm --workspace-concurrency=1 --recursive --if-present build",
    "contracts:check": "node packages/contracts/scripts/check-openapi.mjs"
  }
}
